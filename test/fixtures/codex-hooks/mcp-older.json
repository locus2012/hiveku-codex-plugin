{
  "hiveku": {
    "url": "https://core.hiveku.com/mcp",
    "bearer_token_env_var": "HIVEKU_TOKEN",
    "default_tools_approval_mode": "approve",
    "tools": {
      "deploy_site": {
        "approval_mode": "prompt"
      },
      "memory_update": {
        "approval_mode": "prompt"
      },
      "project_vcs_status": {
        "approval_mode": "approve"
      }
    }
  },
  "playwright": {
    "command": "npx",
    "args": ["@playwright/mcp@latest"]
  }
}
